      "tasks": [
        {
          "id": "0.1",
          "title": "Fix localStorage in sidebar useState",
          "description": "Replace localStorage.getItem in useState initializer with useEffect pattern to prevent hydration mismatch",
          "priority": "CRITICAL",
          "estimatedHours": 1,
          "auditReference": "H-001",
          "riskLevel": "Medium",
          "status": "Not Started",
          "files": ["components/ui/sidebar.tsx"],
          "dependencies": [],
          "acceptanceCriteria": [
            "No hydration warnings in console related to sidebar",
            "Sidebar state persists correctly across page refreshes",
            "SSR renders consistent initial state",
            "Client-side hydration completes without errors"
          ],
          "implementationSteps": [
            "Replace useState(localStorage.getItem(...)) with useState(null)",
            "Add useEffect to read localStorage after mount",
            "Add loading state to prevent flash of incorrect content",
            "Test SSR output matches initial client render"
          ],
          "codeExample": {
            "before": "const [open, setOpen] = useState(() => {\n  if (typeof window !== 'undefined') {\n    return localStorage.getItem('sidebar-open') === 'true';\n  }\n  return true;\n});",
            "after": "const [open, setOpen] = useState(true);\nconst [isHydrated, setIsHydrated] = useState(false);\n\nuseEffect(() => {\n  const stored = localStorage.getItem('sidebar-open');\n  if (stored !== null) {\n    setOpen(stored === 'true');\n  }\n  setIsHydrated(true);\n}, []);"
          }
        },
        {
          "id": "0.2",
          "title": "Replace Math.random() in Skeleton Render Keys",
          "description": "Replace Math.random() for React keys with deterministic index-based keys to prevent hydration mismatch",
          "priority": "CRITICAL",
          "estimatedHours": 0.5,
          "auditReference": "H-002",
          "riskLevel": "Low",
          "status": "Not Started",
          "files": ["components/ui/sidebar.tsx"],
          "dependencies": [],
          "acceptanceCriteria": [
            "No Math.random() calls in render paths",
            "Skeleton elements use stable, deterministic keys",
            "No hydration warnings related to key mismatches"
          ],
          "implementationSteps": [
            "Find all Math.random() usage in component render",
            "Replace with index-based keys (acceptable for static lists)",
            "Or use deterministic ID generation based on content"
          ],
          "codeExample": {
            "before": "{[1, 2, 3].map(() => (\n  <Skeleton key={Math.random()} className=\"h-8\" />\n))}",
            "after": "{[1, 2, 3].map((_, index) => (\n  <Skeleton key={`skeleton-${index}`} className=\"h-8\" />\n))}"
          }
        },
        {
          "id": "0.3",
          "title": "Fix useLocalStorage Hook Initialization",
          "description": "Add initializeWithValue: false option to all useLocalStorage calls to defer localStorage read to client",
          "priority": "CRITICAL",
          "estimatedHours": 1.5,
          "auditReference": "H-003",
          "riskLevel": "Medium",
          "status": "Not Started",
          "files": [
            "lib/settings/provider.tsx",
            "Any file using useLocalStorage hook"
          ],
          "dependencies": [],
          "acceptanceCriteria": [
            "All useLocalStorage calls include { initializeWithValue: false }",
            "No hydration warnings from settings provider",
            "Settings load correctly after hydration",
            "Default values render on SSR"
          ],
          "implementationSteps": [
            "Audit all useLocalStorage usages in codebase",
            "Add initializeWithValue: false option to each call",
            "Handle the undefined initial state appropriately",
            "Add loading states where needed"
          ],
          "codeExample": {
            "before": "const [settings, setSettings] = useLocalStorage('user-settings', defaultSettings);",
            "after": "const [settings, setSettings] = useLocalStorage('user-settings', defaultSettings, {\n  initializeWithValue: false,\n});\n\nconst effectiveSettings = settings ?? defaultSettings;"
          }
        }
      ]
    },
