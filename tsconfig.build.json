{
	"extends": "./tsconfig.json",
	"include": [
		"next-env.d.ts",
		"global.d.ts",
		"app/**/*.ts",
		"app/**/*.tsx",
		"components/**/*.ts",
		"components/**/*.tsx",
		"features/**/*.ts",
		"features/**/*.tsx",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"instrumentation.ts",
		"instrumentation-client.ts",
		"proxy.ts",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"oldapp",
		"plan",
		"coverage",
		"e2e",
		"playwright-report",
		"test-results",
		"tests",
		"components/ai-elements"
	]
}
