# Test Configuration
# Copy to .env.test and set values to enable real service tests

# Cache (Upstash Redis)
TEST_USE_REAL_CACHE=false
# Uses CACHE_KV_REST_API_URL and CACHE_KV_REST_API_TOKEN from .env

# Database (Postgres)
TEST_USE_REAL_DB=false
# Uses DATABASE_URL from .env

# Blob Storage
TEST_USE_REAL_BLOB=false
