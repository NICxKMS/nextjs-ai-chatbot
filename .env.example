# ── Database ──
DATABASE_URL=postgresql://user:pass@host:5432/db    # Required

# ── Cache (Upstash Redis) ──
CACHE_KV_REST_API_URL=https://...upstash.io         # Required
CACHE_KV_REST_API_TOKEN=                             # Required

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000             # Public URL of the app (used for OG images, canonical URLs)

# ── Auth (Supabase) ──
NEXT_PUBLIC_SUPABASE_URL=https://...supabase.co       # Required
NEXT_PUBLIC_SUPABASE_ANON_KEY=                        # Required
SUPABASE_JWT_SECRET=                                 # Required
SUPABASE_ACCESS_TOKEN_COOKIE_NAME=sb-access-token    # Cookie name for Supabase session token
GUEST_JWT_SECRET=                                    # Required (guest auth flow)

# ── AI Providers (at least one required) ──
OPENAI_API_KEY=                                      # Required — primary provider
GEMINI_API_KEY=                        # Optional — Google Gemini
OPENROUTER_API_KEY=                                  # Optional — OpenRouter proxy

# ── Storage ──
BLOB_READ_WRITE_TOKEN=                               # Required (file uploads)

# ── Monitoring (optional) ──
OTEL_EXPORTER_OTLP_ENDPOINT=                         # Optional — OpenTelemetry exporter URL (e.g. http://localhost:4318)
VERCEL_OIDC_TOKEN=                                   # Optional — auto-injected on Vercel

# ── Build Flags (optional) ──
ENABLE_PRODUCTION_BROWSER_SOURCE_MAPS=false           # Expose source maps in production (default: false)
ENABLE_EXPERIMENTAL_INLINE_CSS=false                  # Inline CSS in HTML for reduced round-trips (default: false)
ENABLE_EXPERIMENTAL_VIEW_TRANSITION=false             # Enable View Transitions API (default: false)
