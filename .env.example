# # Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
# AUTH_SECRET=****

# # The following keys below are automatically created and
# # added to your environment when you deploy on vercel

# # AI Gateway API Key (required for non-Vercel deployments)
# # For Vercel deployments, OIDC tokens are used automatically
# # https://vercel.com/ai-gateway
# AI_GATEWAY_API_KEY=****


# # Instructions to create a Vercel Blob Store here: https://vercel.com/docs/storage/vercel-blob
# BLOB_READ_WRITE_TOKEN=****

# # Instructions to create a PostgreSQL database here: https://vercel.com/docs/storage/vercel-postgres/quickstart
# POSTGRES_URL=****


# # Instructions to create a Redis store here:
# # https://vercel.com/docs/redis
# REDIS_URL=****


# # OpenAI Configuration
# OPENAI_API_KEY=sk-proj--
# OPENAI_BASE_URL=https://api.openai.com/v1

# # Anthropic Configuration
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# # Google Gemini Configuration
# GEMINI_API_KEY=

# # OpenRouter Configuration
# # OPENROUTER_API_KEY=
# OPENROUTER_API_KEY=sk-or-v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://localhost:3000 # Identifies your app to models (required by OpenRouter)
# OPENROUTER_TITLE=Your App Name # Optional title shown in OpenRouter dashboard


# # Ai - Gateway variables
# CLOUDFLARE_AI_GATEWAY_ENABLED=true
# CLOUDFLARE_AI_GATEWAY_ACCOUNT_ID=
# CLOUDFLARE_AI_GATEWAY_GATEWAY_ID=chat-api
# CLOUDFLARE_AI_GATEWAY_COMPAT=true
# CLOUDFLARE_WORKER_AI=

# Ai - Gateway variables
CLOUDFLARE_AI_GATEWAY_ENABLED=true
CLOUDFLARE_AI_GATEWAY_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_GATEWAY_GATEWAY=chat-api
CLOUDFLARE_AI_GATEWAY_COMPAT=true
CLOUDFLARE_AI_GATEWAY_API_KEY=

CLOUDFLARE_WORKER_AI=


INCLUDE_VERCEL_MODELS=false