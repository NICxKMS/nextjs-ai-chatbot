# ── Database ──
DATABASE_URL=postgresql://user:pass@host:5432/db    # Required

# ── Cache (Upstash Redis) ──
CACHE_KV_REST_API_URL=https://...upstash.io         # Required
CACHE_KV_REST_API_TOKEN=                             # Required

# ── Auth (Supabase) ──
NEXT_PUBLIC_SUPABASE_URL=https://...supabase.co       # Required
NEXT_PUBLIC_SUPABASE_ANON_KEY=                        # Required
SUPABASE_JWT_SECRET=                                 # Required
GUEST_JWT_SECRET=                                    # Required (guest auth flow)

# ── AI Providers (at least one required) ──
OPENAI_API_KEY=                                      # Required — primary provider
GEMINI_API_KEY=                        # Optional — Google Gemini
OPENROUTER_API_KEY=                                  # Optional — OpenRouter proxy

# ── Storage ──
BLOB_READ_WRITE_TOKEN=                               # Required (file uploads)

# ── Monitoring (optional) ──
VERCEL_OIDC_TOKEN=                                   # Optional — auto-injected on Vercel
