# =============================================================================
# AI Assistant v6 - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication (Auth.js / NextAuth)
# -----------------------------------------------------------------------------
AUTH_URL=http://localhost:3000
AUTH_SECRET=your-auth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Secret for guest JWT tokens
GUEST_JWT_SECRET=your-guest-jwt-secret-here

# -----------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
POSTGRES_URL=postgres://user:password@host:5432/database?sslmode=require
POSTGRES_PRISMA_URL=postgres://user:password@host:6543/database?sslmode=require&pgbouncer=true
POSTGRES_URL_NON_POOLING=postgres://user:password@host:5432/database?sslmode=require
POSTGRES_HOST=db.xxxxx.supabase.co
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Redis Cache (Upstash)
# -----------------------------------------------------------------------------
CACHE_KV_URL=rediss://default:password@host.upstash.io:6379
CACHE_KV_REST_API_URL=https://host.upstash.io
CACHE_KV_REST_API_TOKEN=your-upstash-rest-token
CACHE_KV_REST_API_READ_ONLY_TOKEN=your-upstash-read-token
CACHE_REDIS_URL=rediss://default:password@host.upstash.io:6379

# -----------------------------------------------------------------------------
# AI Providers
# -----------------------------------------------------------------------------
# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key

# -----------------------------------------------------------------------------
# Vercel Services
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Optional: Sentry for error tracking
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# -----------------------------------------------------------------------------
# Development / Analytics (Optional)
# -----------------------------------------------------------------------------
# VERCEL_OIDC_TOKEN - Only needed for Vercel deployments
