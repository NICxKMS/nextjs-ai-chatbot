{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite"],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 4,
    "lineEnding": "lf"
  },
  "files": {
    "includes": ["**/*", "!!**/tests", "!!**/oldapp"]
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off",
        /* Allow namespace imports for React and Radix primitives - standard pattern */
        "noNamespaceImport": "off",
        /* Allow regex in functions - perf impact is negligible for our use cases */
        "useTopLevelRegex": "off",
        /* Allow <img> for small icons and external images not suited for next/image */
        "noImgElement": "off"
      },
      "suspicious": {
        /* Needs more work to fix */
        "noExplicitAny": "off",

        /* Allow for Tailwind @ rules */
        "noUnknownAtRules": "off",

        /* Allowing console for debugging */
        "noConsole": "off",

        /* Needed for generateUUID() */
        "noBitwiseOperators": "off",

        /* Allow array index as key for static lists (skeletons, etc.) */
        "noArrayIndexKey": "off",

        /* Allow async without await - useful for interface compliance */
        "useAwait": "off",

        /* Allow empty blocks for no-op callbacks */
        "noEmptyBlockStatements": "off",

        /* Allow document.cookie for sidebar state - Cookie Store API has poor browser support */
        "noDocumentCookie": "off"
      },
      "style": {
        /* Allowing magic numbers */
        "noMagicNumbers": "off",

        /* Needs more work to fix */
        "noNestedTernary": "off",

        /* Allow non-null assertions for env vars and checked conditions */
        "noNonNullAssertion": "off",

        /* Allow default switch clause to be omitted for exhaustive switches */
        "useDefaultSwitchClause": "off",

        /* Allow import + export pattern for type re-exports */
        "noExportedImports": "off"
      },
      "nursery": {
        /* Too many false positives */
        "noUnnecessaryConditions": "off",
        /* Allow variable shadowing for dynamic imports with same names as type imports */
        "noShadow": "off",
        /* Dynamic images (base64, previews) don't have known dimensions */
        "useImageSize": "off",
        /* Interface is required for declaration merging (e.g., Window) - type would conflict */
        "useConsistentTypeDefinitions": "off"
      },
      "complexity": {
        /* Needs more work to fix */
        "noExcessiveCognitiveComplexity": "off",

        /* This one has false positives. It's a bit... iffy 😉 */
        "useSimplifiedLogicExpression": "off"
      },
      "correctness": {
        /* Allow underscore prefix for intentionally unused parameters */
        "noUnusedFunctionParameters": "off"
      },
      "a11y": {
        /* Needs more work to fix */
        "noSvgWithoutTitle": "off",
        /* Allow role="group" for button groups - semantic elements not always appropriate */
        "useSemanticElements": "off",
        /* Label components are often used with htmlFor set dynamically or via composition */
        "noLabelWithoutControl": "off",
        /* Allow onClick on div for focus forwarding patterns in input addons */
        "noNoninteractiveElementInteractions": "off"
      }
    }
  },
  "overrides": [
    {
      /* Instrumentation files may need special linting rules */
      "includes": ["instrumentation*.ts", "app/global-error.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNamespace": "off"
          }
        }
      }
    }
  ]
}
