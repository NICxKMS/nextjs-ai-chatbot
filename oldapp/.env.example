# ============================================================================
# AUTHENTICATION
# ============================================================================
# Generate a random secret: https://generate-secret.vercel.app/32
# or `openssl rand -base64 32`
# AUTH_SECRET=****


# ============================================================================
# SUPABASE AUTHENTICATION (Required)
# ============================================================================
# Get these from your Supabase project settings: https://supabase.com/dashboard
# NEXT_PUBLIC_SUPABASE_URL=your-project-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_URL=your-project-url
# SUPABASE_JWT_SECRET=your-jwt-secret


# ============================================================================
# APPLICATION (Optional)
# ============================================================================
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_COOKIE_NAME=auth-session
# GUEST_SESSION_SECRET=your-guest-secret


# ============================================================================
# VERCEL DEPLOYMENT
# ============================================================================
# These are automatically created when you deploy on Vercel

# AI Gateway API Key (required for non-Vercel deployments)
# For Vercel deployments, OIDC tokens are used automatically
# https://vercel.com/ai-gateway
# AI_GATEWAY_API_KEY=****


# ============================================================================
# STORAGE & DATABASE
# ============================================================================
# Vercel Blob Store: https://vercel.com/docs/storage/vercel-blob
# BLOB_READ_WRITE_TOKEN=****

# PostgreSQL Database: https://vercel.com/docs/storage/vercel-postgres/quickstart
# DATABASE_URL=****

# Upstash Redis (Rate Limiting): https://upstash.com/docs/redis/overall/getstarted
# Used for API rate limiting
# UPSTASH_REDIS_REST_URL=your-upstash-url
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Upstash Redis (Cache): https://upstash.com/docs/redis/overall/getstarted
# CACHE_KV_REST_API_URL=****
# CACHE_KV_REST_API_TOKEN=****


# ============================================================================
# AI MODEL PROVIDERS
# ============================================================================
# OpenAI
# OPENAI_API_KEY=sk-proj-
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini
# GEMINI_API_KEY=

# OpenRouter
# OPENROUTER_API_KEY=sk-or-v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://localhost:3000
# OPENROUTER_TITLE=Your App Name


# ============================================================================
# CLOUDFLARE AI GATEWAY
# ============================================================================
CLOUDFLARE_AI_GATEWAY_ENABLED=true
CLOUDFLARE_AI_GATEWAY_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_GATEWAY_ID=chat-api
CLOUDFLARE_AI_GATEWAY_COMPAT=true
CLOUDFLARE_AI_GATEWAY_API_KEY=
CLOUDFLARE_WORKER_AI=


# ============================================================================
# FEATURE FLAGS
# ============================================================================
INCLUDE_VERCEL_MODELS=false