{
  "name": "AI Chatbot - Production Monitoring",
  "description": "Comprehensive monitoring dashboard for Next.js AI Chatbot with New Relic",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Overview",
      "description": "System health and performance overview",
      "widgets": [
        {
          "title": "System Health Status",
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT latest(status) as 'System Status' FROM Log WHERE operation = 'Health check' SINCE 5 minutes ago"
              }
            ]
          }
        },
        {
          "title": "Request Rate (per minute)",
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT rate(count(*), 1 minute) as 'Requests/min' FROM Log WHERE level IN ('info', 'warn', 'error') TIMESERIES AUTO"
              }
            ]
          }
        },
        {
          "title": "Error Rate (%)",
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT percentage(count(*), WHERE level = 'error') as 'Error Rate' FROM Log TIMESERIES AUTO"
              }
            ]
          }
        },
        {
          "title": "P95 Response Time (ms)",
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT percentile(duration, 95) as 'P95', percentile(duration, 99) as 'P99' FROM Log WHERE duration IS NOT NULL TIMESERIES AUTO"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "API Performance",
      "description": "Detailed API endpoint performance metrics",
      "widgets": [
        {
          "title": "Chat API Response Time",
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT average(totalTime) as 'Avg', percentile(totalTime, 95) as 'P95' FROM Log WHERE message = 'Chat request completed' TIMESERIES AUTO"
              }
            ]
          }
        },
        {
          "title": "Data Fetch Performance",
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT average(duration) as 'Avg Fetch Time' FROM Log WHERE message = 'Data fetch completed' TIMESERIES AUTO"
              }
            ]
          }
        },
        {
          "title": "Top 10 Slowest Operations",
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT average(duration) as 'Avg Duration (ms)', count(*) as 'Count' FROM Log WHERE duration IS NOT NULL FACET operation LIMIT 10"
              }
            ]
          }
        },
        {
          "title": "API Endpoints by Call Count",
          "visualization": {
            "id": "viz.pie"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT count(*) FROM Log WHERE message IN ('Chat request completed', 'History list', 'Document saved', 'Message voted') FACET message SINCE 1 hour ago"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Database Performance",
      "description": "Database query performance and slow query analysis",
      "widgets": [
        {
          "title": "Database Query Duration (ms)",
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT average(duration) as 'Avg', percentile(duration, 95) as 'P95' FROM Log WHERE operation = 'query' TIMESERIES AUTO"
              }
            ]
          }
        },
        {
          "title": "Slow Queries (> 500ms)",
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT query, duration, timestamp FROM Log WHERE message = 'Slow database query detected' SINCE 1 hour ago LIMIT 20"
              }
            ]
          }
        },
        {
          "title": "Transaction Duration (ms)",
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT average(duration) as 'Avg', percentile(duration, 95) as 'P95' FROM Log WHERE operation = 'transaction' TIMESERIES AUTO"
              }
            ]
          }
        },
        {
          "title": "Database Operations by Type",
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT count(*) FROM Log WHERE operation IN ('query', 'transaction') FACET operation TIMESERIES AUTO"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Cache Performance",
      "description": "Redis cache hit rates and operation timing",
      "widgets": [
        {
          "title": "Cache Hit Rate (%)",
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT percentage(count(*), WHERE cache.hit = true) as 'Hit Rate' FROM Span WHERE cache.hit IS NOT NULL SINCE 15 minutes ago"
              }
            ]
          }
        },
        {
          "title": "Cache Operations - Hits vs Misses",
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT count(*) as 'Operations' FROM Span WHERE cache.hit IS NOT NULL FACET cache.hit TIMESERIES AUTO"
              }
            ]
          }
        },
        {
          "title": "Cache Operation Latency (ms)",
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT average(cache.latency_ms) as 'Avg Latency' FROM Span WHERE cache.latency_ms IS NOT NULL TIMESERIES AUTO"
              }
            ]
          }
        },
        {
          "title": "Cache Status by Component",
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT latest(status) as 'Status' FROM Log WHERE message = 'Health check' FACET cache SINCE 5 minutes ago"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Business Metrics",
      "description": "Usage metrics and business analytics",
      "widgets": [
        {
          "title": "Chats Created (per hour)",
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT count(*) as 'New Chats' FROM Log WHERE isNewChat = true TIMESERIES 1 hour"
              }
            ]
          }
        },
        {
          "title": "Messages Sent (per hour)",
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT sum(messageCount) as 'Total Messages' FROM Log WHERE messageCount IS NOT NULL TIMESERIES 1 hour"
              }
            ]
          }
        },
        {
          "title": "Active Users (unique per hour)",
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT uniqueCount(userId) as 'Active Users' FROM Log WHERE userId IS NOT NULL TIMESERIES 1 hour"
              }
            ]
          }
        },
        {
          "title": "Popular AI Models",
          "visualization": {
            "id": "viz.pie"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT count(*) FROM Log WHERE modelId IS NOT NULL FACET modelId SINCE 24 hours ago LIMIT 10"
              }
            ]
          }
        },
        {
          "title": "Document Operations",
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT count(*) FROM Log WHERE message IN ('Document saved', 'Document versions deleted') FACET message TIMESERIES AUTO"
              }
            ]
          }
        },
        {
          "title": "User Actions Distribution",
          "visualization": {
            "id": "viz.pie"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT count(*) FROM Log WHERE message IN ('Chat request completed', 'History list', 'Document saved', 'Message voted', 'Chat deleted') FACET message SINCE 24 hours ago"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Error Tracking",
      "description": "Error analysis and debugging",
      "widgets": [
        {
          "title": "Error Count by Type",
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT count(*) FROM Log WHERE level = 'error' FACET message SINCE 1 hour ago LIMIT 10"
              }
            ]
          }
        },
        {
          "title": "Recent Errors",
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT timestamp, message, userId, chatId, error FROM Log WHERE level = 'error' SINCE 1 hour ago LIMIT 50"
              }
            ]
          }
        },
        {
          "title": "Error Rate by Endpoint",
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT percentage(count(*), WHERE level = 'error') as 'Error Rate' FROM Log FACET operation TIMESERIES AUTO"
              }
            ]
          }
        },
        {
          "title": "Top Failing Operations",
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 7448597,
                "query": "SELECT count(*) as 'Error Count' FROM Log WHERE level = 'error' FACET message, operation SINCE 24 hours ago LIMIT 20"
              }
            ]
          }
        }
      ]
    }
  ]
}
